{
  "name": "unity-prefab-to-quarks",
  "version": "1.0.0",
  "description": "Unity Prefab ParticleSystem to three.quarks converter",
  "type": "module",
  "scripts": {
    "dev": "npx concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npx tsx watch src/server/index.ts",
    "dev:client": "npx vite",
    "build": "npx tsc && npx vite build",
    "preview": "npx vite preview"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "yaml": "^2.3.4",
    "three": "^0.170.0",
    "three.quarks": "^0.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.10.0",
    "@types/three": "^0.170.0",
    "typescript": "^5.3.0",
    "tsx": "^4.6.0",
    "vite": "^5.0.0",
    "concurrently": "^8.2.2"
  }
}
